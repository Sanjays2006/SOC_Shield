# ============================================================
# SOCShield Backend — Environment Configuration (EXAMPLE)
# ------------------------------------------------------------
# Copy this file to ".env" and fill in REAL values.
# NEVER commit the real ".env" file. Placeholders only here.
# ============================================================

# ---- Flask runtime ----
# Set to "production" in real deployments. Controls debug mode.
FLASK_ENV=development
# Debug must be false in production. "1"/"true" enables Flask debug.
FLASK_DEBUG=false
# Host/port the backend binds to.
HOST=127.0.0.1
PORT=5000
# Secret key for Flask sessions/signing. Generate a long random value.
SECRET_KEY=change-me-to-a-long-random-string

# ---- MongoDB ----
# Use authentication in real deployments:
#   mongodb://<user>:<pass>@<host>:27017/socshield?authSource=admin
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB=socshield

# ---- CORS ----
# Comma-separated list of trusted frontend origins. NO wildcard in prod.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Telegram alerting (optional) ----
# Leave blank to disable Telegram notifications.
# IMPORTANT: the token previously committed to this repo is COMPROMISED
# and must be revoked in @BotFather. Generate a NEW token here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Automated response ----
# Guard rail: automated firewall blocking is DISABLED by default.
# Only enable in an explicitly authorized environment.
ENABLE_AUTO_BLOCK=false

# ---- External intel API ----
IP_API_BASE=http://ip-api.com/json

# ---- AI incident summaries (optional) ----
# Provider: "none" (deterministic fallback only), "openai", or "ollama".
LLM_PROVIDER=none
# API key for the LLM provider. NEVER commit a real key. Leave blank for
# provider "none" or "ollama" (local).
LLM_API_KEY=
# Model name (e.g. gpt-4o-mini for OpenAI, llama3 for Ollama).
LLM_MODEL=gpt-4o-mini
# Base URL for OpenAI-compatible or local endpoints.
# OpenAI: leave blank. Ollama: http://127.0.0.1:11434
LLM_BASE_URL=
LLM_TIMEOUT=20

# ---- Risk engine weights (optional overrides, 0..1 each) ----
RISK_W_ATTACK=0.45
RISK_W_SURICATA=0.20
RISK_W_ANOMALY=0.20
RISK_W_ASSET=0.15

# ---- ML models directory (optional) ----
SOCSHIELD_MODELS_DIR=models

# ---- Authentication & RBAC ----
# Master switch. Set to false ONLY for local development (allows all).
AUTH_ENABLED=true
# Strong random secret for signing JWTs. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in minutes (default 480 = 8h).
JWT_EXPIRY_MIN=480
# Seed admin created at startup if the users collection is empty.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=
# Shared key the agent uses to authenticate to /ingest (service-to-service).
INGEST_API_KEY=
